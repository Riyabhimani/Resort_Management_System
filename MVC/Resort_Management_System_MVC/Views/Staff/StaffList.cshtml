@section Styles {
    <style>
        :root {
            --rose: #cb8670;
            --rose-dark: #a55e4b;
            --light-bg: #fff9f6;
        }

        .resort-page-container {
            padding: 40px 0;
            background: linear-gradient(to bottom right, #fff9f6, #fcefe9);
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
        }

        .resort-card {
            width: 100%;
            max-width: 1400px;
            background: white;
            padding: 30px 40px;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .page-title {
            color: var(--rose-dark);
            font-weight: 700;
            font-size: 1.6rem;
            display: flex;
            align-items: center;
        }

        .filter-section {
            background: var(--light-bg);
            padding: 15px 20px;
            border-radius: 14px;
            border: 1px solid #f1d3c7;
            box-shadow: 0 3px 10px rgba(203, 134, 112, 0.1);
        }

        .btn-search {
            background: var(--rose);
            border: none;
            color: white;
            padding: 6px 14px;
            border-radius: 6px;
            font-weight: 500;
        }

            .btn-search:hover {
                background: var(--rose-dark);
                color: #fff;
            }

        .btn-outline-rose {
            border: 1px solid var(--rose);
            color: var(--rose);
            background: transparent;
            border-radius: 6px;
            padding: 6px 14px;
            font-weight: 500;
        }

            .btn-outline-rose:hover {
                background: var(--rose);
                color: white;
            }

        .btn-outline-gray {
            border: 1px solid #6c757d;
            color: #6c757d;
            background: transparent;
            border-radius: 6px;
            padding: 6px 14px;
            font-weight: 500;
        }

            .btn-outline-gray:hover {
                background: #6c757d;
                color: white;
            }

        /* 🌿 TABLE STYLE — updated same as Booking List */
        .table {
            width: 100%;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
        }

            .table thead {
                position: sticky;
                top: 0;
                background-color: #6c757d !important;
                color: #ffcc99 !important;
                text-align: center;
                font-weight: 600;
                font-size: 0.9rem;
                z-index: 1;
            }

            .table th,
            .table td {
                padding: 10px 12px;
                vertical-align: middle;
                border-color: #dee2e6;
            }

            .table tbody tr:hover {
                background-color: #fff3e6 !important;
            }

        .table-bordered {
            border: 1px solid #dee2e6;
        }

        /* 🧭 Action Buttons */
        .action-btn {
            padding: 6px 10px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: 0.3s;
            border: 1px solid transparent;
        }

        .edit-btn {
            border: 1px solid #198754;
            color: #198754;
            background: transparent;
        }

            .edit-btn:hover {
                background-color: #198754;
                color: #fff;
            }

        .delete-btn {
            border: 1px solid #dc3545;
            color: #dc3545;
            background: transparent;
        }

            .delete-btn:hover {
                background-color: #dc3545;
                color: #fff;
            }
    </style>
}
