@model List<StaffModel>
@{
    ViewData["Title"] = "Staff List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="resort-page-container">
    <div class="guest-card shadow">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0" style="color:#a55e4b"><b>Staff List</b></h3>

            <!-- Add Staff Button -->
            <a asp-action="StaffAddEdit" asp-controller="Staff"
               style="border:1px solid #a55e4b; color:#a55e4b; background:transparent; font-weight:500; padding:4px 10px; border-radius:4px; font-size:0.875rem; line-height:1.5; display:inline-flex; align-items:center; gap:6px; cursor:pointer; text-decoration:none;"
               onmouseover="this.style.backgroundColor='#a55e4b'; this.style.color='#fff';"
               onmouseout="this.style.backgroundColor='transparent'; this.style.color='#a55e4b';">
                <i class="bi bi-person-plus-fill" style="font-size:16px;"></i>
                <span>Add Staff</span>
            </a>
        </div>

        <!-- 🔍 Search & Filter Section -->
        <div class="filter-section mb-4">
            <form asp-action="SearchStaff" method="get" class="row g-2 align-items-center">
                <div class="col-md-2">
                    <input type="number" name="staffId" class="form-control form-control-sm" placeholder="Staff ID" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="fullName" class="form-control form-control-sm" placeholder="Full Name" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="role" class="form-control form-control-sm" placeholder="Role" />
                </div>
                <div class="col-md-4 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Top10Staff" asp-controller="Staff" class="btn btn-success btn-sm">
                        <i class="bi bi-list-ol me-1"></i>Top 10
                    </a>
                    <a asp-action="StaffList" asp-controller="Staff" class="btn btn-secondary btn-sm">
                        <i class="bi bi-arrow-clockwise me-1"></i>Full List
                    </a>
                </div>
            </form>
        </div>

        <!-- ✅ Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <!-- 🌿 Table -->
        <div class="scroll-box">
            <table class="table table-bordered align-middle mb-0 bg-white">
                <thead class="text-center bg-secondary text-warning">
                    <tr>
                        <th>Staff ID</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Contact</th>
                        <th>Joining Date</th>
                        <th>Salary</th>
                        <th>Active</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StaffId</td>
                                <td>@item.FullName</td>
                                <td>@item.Role</td>
                                <td>@item.Email</td>
                                <td>@item.ContactNumber</td>
                                <td>@item.JoiningDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.Salary</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                                <td>@item.Created.ToString("yyyy-MM-dd")</td>
                                <td>@item.Modified?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="StaffAddEdit" asp-controller="Staff" asp-route-id="@item.StaffId"
                                           style="border:1px solid #198754; color:#198754; background:transparent; font-weight:500; padding:4px 10px; border-radius:4px; font-size:0.875rem; line-height:1.5; display:inline-flex; align-items:center; gap:6px; cursor:pointer; text-decoration:none;"
                                           onmouseover="this.style.backgroundColor='#198754'; this.style.color='#fff';"
                                           onmouseout="this.style.backgroundColor='transparent'; this.style.color='#198754';">
                                            <i class="bi bi-pencil-square" style="font-size:16px;"></i>
                                        </a>

                                        <a asp-action="StaffDelete" asp-controller="Staff" asp-route-id="@item.StaffId"
                                           style="border:1px solid #dc3545; color:#dc3545; background:transparent; font-weight:500; padding:4px 10px; border-radius:4px; font-size:0.875rem; line-height:1.5; display:inline-flex; align-items:center; gap:6px; cursor:pointer; text-decoration:none;"
                                           onmouseover="this.style.backgroundColor='#dc3545'; this.style.color='#fff';"
                                           onmouseout="this.style.backgroundColor='transparent'; this.style.color='#dc3545';">
                                            <i class="bi bi-trash-fill" style="font-size:16px;"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="11" class="text-muted">No Staff Found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteLinks = document.querySelectorAll(".sweet-delete");
            deleteLinks.forEach(link => {
                link.addEventListener("click", function (e) {
                    e.preventDefault();
                    const url = this.getAttribute("href");

                    Swal.fire({
                        title: "Are you sure?",
                        text: "This staff record will be deleted permanently.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#d33",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = url;
                        }
                    });
                });
            });
        });
    </script>
}

