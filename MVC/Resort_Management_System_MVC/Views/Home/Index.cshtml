@*<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Resort Dashboard — Full UI</title>

    <!-- Palatin theme CSS (use your theme files) -->
    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/style.css" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --accent: #cb8670;
            --muted: #6b6b6b
        }

        body {
            background: #f6f5f4;
            font-family: Inter,system-ui,Arial;
            margin: 0;
            padding: 0
        }

        .container {
            max-width: 1200px;
            margin: 24px auto;
            padding: 0 16px
        }

        header.site-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px
        }

            .brand h1 {
                font-size: 20px;
                margin: 0;
                color: #333
            }

        /* Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px
        }

        .card {
            background: #fff;
            border-radius: 14px;
            padding: 18px;
            box-shadow: 0 6px 18px rgba(37,37,37,0.06);
        }

            .card .title {
                font-size: 13px;
                color: var(--muted);
                margin-bottom: 8px
            }

            .card .value {
                font-size: 22px;
                font-weight: 700;
                color: #222
            }

            .card .meta {
                font-size: 12px;
                color: #888;
                margin-top: 8px
            }

        /* Layout sections */
        .grid-3 {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
            margin-top: 18px
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 18px
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse
        }

            table thead th {
                background: var(--accent);
                color: #fff;
                padding: 10px;
                border-radius: 6px
            }

            table tbody td {
                padding: 10px;
                border-bottom: 1px solid #f0f0f0
            }

        /* small helpers */
        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px
        }

        .btn {
            background: var(--accent);
            border: none;
            color: #fff;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer
        }

        .muted {
            color: var(--muted)
        }

        @@media (max-width:900px) {
            .cards

        {
            grid-template-columns: repeat(2,1fr)
        }

        .grid-3 {
            grid-template-columns: 1fr
        }

        .grid-2 {
            grid-template-columns: 1fr
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <header class="site-header">
            <div class="brand">
                <img src="img/logo.png" alt="logo" style="width:44px;height:44px;border-radius:8px;object-fit:cover" />
                <div>
                    <h1>Resort Dashboard</h1>
                    <div class="muted" style="font-size:12px">Live overview of bookings, revenue & services</div>
                </div>
            </div>

            <div style="display:flex;gap:10px;align-items:center">
                <button id="refreshBtn" class="btn">Refresh</button>
                <div style="font-size:14px;color:#444">Welcome, Admin</div>
            </div>
        </header>

        <!-- STAT CARDS -->
        <section class="cards" id="statsCards">
            <!-- cards rendered by JS -->
        </section>

        <!-- CHARTS + SIDE STATS -->
        <section class="grid-3">
            <div class="card">
                <div class="section-title">
                    <h3 style="margin:0;font-size:16px">Monthly Revenue</h3>
                    <div class="muted">This year</div>
                </div>
                <canvas id="revenueChart" height="150"></canvas>
            </div>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div class="card">
                    <div class="section-title"><h3 style="margin:0;font-size:16px">Room Occupancy</h3><div class="muted">Now</div></div>
                    <canvas id="occupancyChart" height="120"></canvas>
                    <div style="display:flex;gap:10px;margin-top:12px">
                        <div class="muted">Total Rooms: <span id="totalRooms">0</span></div>
                        <div class="muted">Occupancy Rate: <span id="occupancyRate">0%</span></div>
                    </div>
                </div>

                <div class="card">
                    <div class="section-title"><h3 style="margin:0;font-size:16px">Top Guest Services</h3><div class="muted">Most requested</div></div>
                    <div id="guestServicesList"></div>
                </div>
            </div>
        </section>

        <!-- WEEKLY CHART + ROOM TYPE -->
        <section class="grid-2">
            <div class="card">
                <div class="section-title"><h3 style="margin:0;font-size:16px">Weekly Bookings & Reservations</h3><div class="muted">Last 7 days</div></div>
                <canvas id="weeklyChart" height="110"></canvas>
            </div>

            <div class="card">
                <div class="section-title"><h3 style="margin:0;font-size:16px">Room Type Stats</h3><div class="muted">Reservations & Avg stay</div></div>
                <canvas id="roomTypeChart" height="110"></canvas>
            </div>
        </section>

        <!-- TABLES: Recent Reservations & Today Payments -->
        <section class="grid-2">
            <div class="card">
                <div class="section-title">
                    <h3 style="margin:0;font-size:16px">Recent Reservations</h3>
                    <div>
                        <button id="viewAllRes" class="btn" style="background:#fff;color:var(--accent);border:1px solid var(--accent);">View All</button>
                    </div>
                </div>
                <div style="overflow:auto;max-height:320px">
                    <table>
                        <thead>
                            <tr><th>Guest</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Status</th><th>Amount</th></tr>
                        </thead>
                        <tbody id="recentReservationsTbody"></tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="section-title">
                    <h3 style="margin:0;font-size:16px">Today's Payments</h3>
                    <div class="muted" id="paymentsCount">0</div>
                </div>
                <div style="overflow:auto;max-height:320px">
                    <table>
                        <thead>
                            <tr><th>Guest</th><th>Time</th><th>Amount</th><th>Method</th><th>Status</th></tr>
                        </thead>
                        <tbody id="todayPaymentsTbody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- FOOTER ACTIONS -->
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:18px">
            <button id="exportCsv" class="btn" style="background:#fff;color:var(--accent);border:1px solid var(--accent);">Export Payments CSV</button>
        </div>

    </div>

    <script>
        // API base
        const API = "http://localhost:5159/api/dashboard";

        // Charts instances
        let revenueChart, occupancyChart, weeklyChart, roomTypeChart;

        // helpers
        const fmtCurrency = v => '₹' + Number(v || 0).toLocaleString();
        const el = id => document.getElementById(id);

        async function fetchJson(path){
          const res = await fetch(path);
          if(!res.ok) throw new Error('Network error');
          return res.json();
        }

        // Render stat cards
        async function loadStats(){
          try{
            const s = await fetchJson(API + '/stats');
            const items = [
              {title:'Total Users', value: s.totalUsers, meta:`Active users`},
              {title:'Total Guests', value: s.totalGuests, meta:`All-time guests`},
              {title:'Today Reservations', value: s.todayReservations, meta:`Reservations today`},
              {title:'Today Bookings', value: s.todayBookings, meta:`Bookings today`},
              {title:'Today Revenue', value: fmtCurrency(s.todayRevenue), meta:`Completed payments`},
              {title:'Available Rooms', value: s.availableRooms, meta:`Rooms ready`},
              {title:'Occupied Rooms', value: s.occupiedRooms, meta:`Currently occupied`},
              {title:'Pending Reservations', value: s.pendingReservations, meta:`Need action`}
            ];

            const html = items.map(i=>`<div class="card"><div class="title">${i.title}</div><div class="value">${i.value}</div><div class="meta">${i.meta}</div></div>`).join('');
            el('statsCards').innerHTML = html;

            // update small stats
            el('totalRooms').innerText = s.totalRooms;
            el('occupancyRate').innerText = s.occupancyRate + '%';

          }catch(err){console.error('loadStats',err)}
        }

        // Revenue chart
        async function loadRevenueChart(){
          try{
            const data = await fetchJson(API + '/revenue-chart');
            const labels = data.map(d=>d.month);
            const values = data.map(d=>Number(d.revenue || 0));

            if(revenueChart) revenueChart.destroy();
            revenueChart = new Chart(el('revenueChart'),{
              type:'bar',
              data:{labels, datasets:[{label:'Revenue',data:values,backgroundColor:getGradient(el('revenueChart'))}]},
              options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}
            });
          }catch(err){console.error('revenueChart',err)}
        }

        // Occupancy
        async function loadOccupancy(){
          try{
            const d = await fetchJson(API + '/occupancy');
            const labels = d.labels;
            const values = d.data;
            if(occupancyChart) occupancyChart.destroy();
            occupancyChart = new Chart(el('occupancyChart'),{type:'doughnut',data:{labels,datasets:[{data:values}]},options:{plugins:{legend:{position:'bottom'}}}});
          }catch(err){console.error('occupancy',err)}
        }

        // Weekly bookings
        async function loadWeekly(){
          try{
            const d = await fetchJson(API + '/weekly-bookings');
            const labels = d.map(x=>x.day);
            const bookings = d.map(x=>x.bookingsCount);
            const reservations = d.map(x=>x.reservationsCount);
            if(weeklyChart) weeklyChart.destroy();
            weeklyChart = new Chart(el('weeklyChart'),{type:'line',data:{labels,datasets:[{label:'Bookings',data:bookings,fill:false,borderColor:getCssVar('--accent')},{label:'Reservations',data:reservations,fill:false,borderColor:'#4CAF50'}]},options:{plugins:{legend:{display:true}}}});
          }catch(err){console.error('weekly',err)}
        }

        // Room type stats
        async function loadRoomType(){
          try{
            const d = await fetchJson(API + '/room-type-stats');
            const labels = d.map(x=>x.roomType);
            const values = d.map(x=>Number(x.totalReservations));
            if(roomTypeChart) roomTypeChart.destroy();
            roomTypeChart = new Chart(el('roomTypeChart'),{type:'bar',data:{labels,datasets:[{label:'Reservations',data:values}]},options:{plugins:{legend:{display:false}}}});
          }catch(err){console.error('roomtype',err)}
        }

        // Recent reservations table
        async function loadRecentReservations(){
          try{
            const list = await fetchJson(API + '/recent-reservations');
            const html = list.map(r=>`<tr><td>${escapeHtml(r.guestName)}</td><td>${escapeHtml(r.roomNumber)}<div style="font-size:11px;color:#999">${escapeHtml(r.roomType)}</div></td><td>${r.checkInDate}</td><td>${r.checkOutDate}</td><td>${escapeHtml(r.status)}</td><td>${fmtCurrency(r.amount)}</td></tr>`).join('');
            el('recentReservationsTbody').innerHTML = html;
          }catch(err){console.error('recentReservations',err)}
        }

        // Today's payments
        async function loadTodayPayments(){
          try{
            const list = await fetchJson(API + '/today-payments');
            el('paymentsCount').innerText = list.length + ' payments';
            const html = list.map(p=>`<tr><td>${escapeHtml(p.guestName)}</td><td>${p.paymentTime}</td><td>${fmtCurrency(p.amount)}</td><td>${escapeHtml(p.paymentMethod)}</td><td>${escapeHtml(p.status)}</td></tr>`).join('');
            el('todayPaymentsTbody').innerHTML = html;
          }catch(err){console.error('todayPayments',err)}
        }

        // Guest services
        async function loadGuestServices(){
          try{
            const list = await fetchJson(API + '/guest-services');
            const html = list.map(s=>`<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed #eee"><div><strong>${escapeHtml(s.serviceName)}</strong><div style="font-size:12px;color:#888">${s.totalRequests} requests</div></div><div style="text-align:right">${fmtCurrency(s.totalRevenue)}</div></div>`).join('');
            el('guestServicesList').innerHTML = html;
          }catch(err){console.error('guestServices',err)}
        }

        // Utilities
        function getCssVar(name){return getComputedStyle(document.documentElement).getPropertyValue(name) || getComputedStyle(document.body).getPropertyValue(name)}
        function getGradient(canvas){try{const ctx=canvas.getContext('2d');const g=ctx.createLinearGradient(0,0,0,300);g.addColorStop(0,'rgba(203,134,112,0.9)');g.addColorStop(1,'rgba(203,134,112,0.4)');return g}catch(e){return '#cb8670'}}
        function escapeHtml(s){if(!s) return '';return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}

        // Export payments CSV
        async function exportPaymentsCSV(){
          try{
            const list = await fetchJson(API + '/today-payments');
            const rows = [['PaymentId','GuestName','Time','Amount','Method','Status']];
            for(const p of list) rows.push([p.paymentId,p.guestName,p.paymentTime,p.amount,p.paymentMethod,p.status]);
            const csv = rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
            const blob = new Blob([csv],{type:'text/csv'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = 'today-payments.csv'; a.click(); URL.revokeObjectURL(url);
          }catch(err){console.error('export',err)}
        }

        // Initial load
        async function loadAll(){
          await Promise.allSettled([loadStats(),loadRevenueChart(),loadOccupancy(),loadWeekly(),loadRoomType(),loadRecentReservations(),loadTodayPayments(),loadGuestServices()]);
        }

        // Events
        document.getElementById('refreshBtn').addEventListener('click', ()=> loadAll());
        document.getElementById('exportCsv').addEventListener('click', exportPaymentsCSV);
        document.getElementById('viewAllRes').addEventListener('click', ()=> window.location.href = '/reservations');

        // run
        loadAll();
    </script>
</body>
</html>*@


