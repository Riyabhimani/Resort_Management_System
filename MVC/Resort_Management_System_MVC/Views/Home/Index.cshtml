                data:{ labels:d.labels, datasets:[{ data:d.data, backgroundColor:["#cb8670","#6c757d","#ffc107"] }] },
                options:{ plugins:{ legend:{ position:"bottom" } } }
            });
        }

        // Weekly bookings
        async function loadWeeklyChart() {
            const d = await fetchJson(API + "/weekly-bookings");
            if(weeklyChart) weeklyChart.destroy();
            weeklyChart = new Chart(el("weeklyChart"), {
                type:"line",
                data:{
                    labels:d.map(x=>x.day),
                    datasets:[
                        { label:"Bookings", data:d.map(x=>x.bookingsCount), borderColor:"#cb8670", fill:false },
                        { label:"Reservations", data:d.map(x=>x.reservationsCount), borderColor:"#28a745", fill:false }
                    ]
                }
            });
        }

        // Room type stats
        async function loadRoomTypeChart() {
            const d = await fetchJson(API + "/room-type-stats");
            if(roomTypeChart) roomTypeChart.destroy();
            roomTypeChart = new Chart(el("roomTypeChart"), {
                type:"pie",
                data:{ labels:d.map(x=>x.roomType), datasets:[{ data:d.map(x=>x.totalReservations), backgroundColor:["#cb8670","#6f42c1","#20c997","#fd7e14","#0dcaf0"] }] }
            });
        }

        // Reservations table
        async function loadRecentReservations() {
            const list = await fetchJson(API + "/recent-reservations");
            el("recentReservationsTbody").innerHTML = list.map(r=>`
                <tr>
                  <td>${r.guestName}</td>
                  <td>${r.roomNumber} <div style="font-size:11px;color:#999">${r.roomType}</div></td>
                  <td>${r.checkInDate}</td>
                  <td>${r.checkOutDate}</td>
                  <td>${r.status}</td>
                  <td>${fmtCurrency(r.amount)}</td>
                </tr>`).join("");
        }

        // Payments table
        async function loadTodayPayments() {
            const list = await fetchJson(API + "/today-payments");
            el("paymentsCount").innerText = list.length + " payments";
            el("todayPaymentsTbody").innerHTML = list.map(p=>`
                <tr>
                  <td>${p.guestName}</td>
                  <td>${p.paymentTime}</td>
                  <td>${fmtCurrency(p.amount)}</td>
                  <td>${p.paymentMethod}</td>
                  <td>${p.status}</td>
                </tr>`).join("");
        }

        // CSV export
        async function exportPaymentsCSV() {
            const list = await fetchJson(API + "/today-payments");
            const rows = [["PaymentId","Guest","Time","Amount","Method","Status"]];
            list.forEach(p=> rows.push([p.paymentId,p.guestName,p.paymentTime,p.amount,p.paymentMethod,p.status]));
            const csv = rows.map(r=>r.join(",")).join("\n");
            const blob = new Blob([csv], {type:"text/csv"});
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a"); a.href=url; a.download="today-payments.csv"; a.click();
            URL.revokeObjectURL(url);
        }

        // Initial load
        async function loadAll() {
            await Promise.allSettled([
                loadStats(),
                loadRevenueChart(),
                loadOccupancyChart(),
                loadWeeklyChart(),
                loadRoomTypeChart(),
                loadRecentReservations(),
                loadTodayPayments()
            ]);
        }

        // Events
        el("refreshBtn").addEventListener("click", loadAll);
        el("exportCsv").addEventListener("click", exportPaymentsCSV);
        el("viewAllRes").addEventListener("click", ()=> window.location.href = '@Url.Action("ReservationList", "Reservation")');

        loadAll();

            document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("themeToggle");

            // Load theme from localStorage if saved
            if (localStorage.getItem("theme") === "dark") {
                document.body.classList.add("dark-mode");
                toggleBtn.textContent = "☀️ Light Mode";
            }

            toggleBtn.addEventListener("click", () => {
                document.body.classList.toggle("dark-mode");

                if (document.body.classList.contains("dark-mode")) {
                    toggleBtn.textContent = "☀️ Light Mode";
                    localStorage.setItem("theme", "dark");
                } else {
                    toggleBtn.textContent = "🌙 Dark Mode";
                    localStorage.setItem("theme", "light");
                }
            });
        });

    </script>
</body>
</html>
